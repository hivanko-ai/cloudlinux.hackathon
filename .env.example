#
# Copy to ".env" and fill values.
#

# Gmail: search query to locate the Gemini email
GMAIL_QUERY=subject:"Imunify360 Product Demo" newer_than:65d

# If there can be multiple matching emails, we will pick the newest unless you set this.
# GMAIL_MESSAGE_ID=

# Google Drive folder path (in "My Drive") where month folders live
# This tool will create missing folders along the path.
DRIVE_BASE_PATH=Imunify/Demo

# Slite table URL (the "Demos" table page you showed in screenshots)
SLITE_TABLE_URL=https://cloudlinux.slite.com/api/s/CTW2qURR1G5hXe/Test-Recording

# If Slite requires org-specific SSO/login, you will login in the opened browser once.

